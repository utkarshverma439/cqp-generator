# Backend Configuration
# All paths can be absolute or relative to the project root

# Path to the CQP template file
# Default: <project_root>/../candidate_pack/template/CQP_Template.docx
# TEMPLATE_PATH=./template/CQP_Template.docx

# Path to the inputs directory (for development/testing)
# Default: <project_root>/../candidate_pack/inputs
# INPUTS_DIR=./inputs

# Path to the outputs directory (generated documents)
# Default: <project_root>/outputs
# OUTPUTS_DIR=./outputs

# Server configuration
HOST=0.0.0.0
PORT=8000

# Framework and lab constants
